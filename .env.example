# Opsiyonel — verilmezse src/firebase.js içindeki sabit değerlere düşer,
# davranış değişmez. Netlify'da farklı bir Firebase projesi (ör. ayrı bir
# staging ortamı) kullanmak isterseniz Site settings > Environment variables
# altına bu adlarla ekleyin.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
